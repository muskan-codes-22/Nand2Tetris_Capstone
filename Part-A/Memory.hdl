CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:

    // Separate RAM from I/O
    DMux(in=load, sel=address[14], a=loadRAM, b=loadIO);

    // Separate Screen from Keyboard
    DMux(in=loadIO, sel=address[13], a=loadScreen, b=loadKeyboard);

    // RAM16K
    RAM16K(
        in=in,
        load=loadRAM,
        address=address[0..13],
        out=ramOut
    );

    // Screen
    Screen(
        in=in,
        load=loadScreen,
        address=address[0..12],
        out=screenOut
    );

    // Keyboard
    Keyboard(out=keyboardOut);

    // Select Screen or Keyboard
    Mux16(
        a=screenOut,
        b=keyboardOut,
        sel=address[13],
        out=ioOut
    );

    // Select RAM or I/O
    Mux16(
        a=ramOut,
        b=ioOut,
        sel=address[14],
        out=out
    );
}
